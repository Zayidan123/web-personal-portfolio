# ─── SECURITY: Environment & Secrets ───────────────────────────────────────
# NEVER commit environment files — they contain API keys, tokens, passwords
.env
.env.*
!.env.example
!.env.local.example

# ─── SECURITY: Sensitive files ─────────────────────────────────────────────
# Database files
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3

# Credentials & tokens
*.pem
*.key
*.p12
*.pfx
*.cert
credentials.json
service-account*.json
token.json
.github_token
.git-credentials
.netrc

# IDE & tool secrets
.vscode/settings.json
.idea/workspace.xml

# ─── Vercel / Cloudflare ───────────────────────────────────────────────────
.vercel
.cloudflare

